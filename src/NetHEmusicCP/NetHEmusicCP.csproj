<Project Sdk="Microsoft.NET.Sdk" InitialTargets="GenerateApiSecrets">

  <!-- 真实 API 地址不入库：来自本地 build.local.props（已 gitignore）或环境变量 NETHE_API_BASE -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)..\..\build.local.props')" />
  <PropertyGroup>
    <NetHEApiBase Condition="'$(NetHEApiBase)' == ''">$(NETHE_API_BASE)</NetHEApiBase>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>netHEmusic</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>NU1701</NoWarn>

    <!-- 无打包（unpackaged）自包含部署：便于自签名 + 安装包分发 -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationIcon>..\..\resources\icon.ico</ApplicationIcon>

    <Version>26.9.24.11</Version>
    <AssemblyVersion>26.9.24.11</AssemblyVersion>
    <FileVersion>26.9.24.11</FileVersion>
    <Product>netHEmusic 网易云音乐下载器</Product>
    <Description>netHEmusic - 网易云音乐第三方 WinUI3 + Fluent 下载/播放器（26.9.24.11）</Description>
    <Company>netHEmusic</Company>
    <Copyright>Copyright (C) 2026 netHEmusic</Copyright>
    <Authors>laohehehe</Authors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.5.240802000" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="..\..\resources\logo.png" Link="Assets\logo.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 证书是 gitignore 的（只有本机 / 发布时才有），所以必须加 Exists 判断：
         否则全新的 clone（比如 GitHub Actions 上）会因为拷不到这个文件直接编译失败（MSB3030） -->
    <None Include="..\..\resources\LaoheTeam.cer" Link="Assets\LaoheTeam.cer" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\resources\LaoheTeam.cer')" />
    <None Include="..\..\lang\**\*" Link="lang\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 编译期生成 API 地址常量：仓库源码里不出现任何地址。
       用 InitialTargets 保证在任何编译步骤之前跑（挂在 BeforeCompile 上会被 WinUI 的 XAML 编译抢先）。 -->
  <Target Name="GenerateApiSecrets">
    <PropertyGroup>
      <_ApiSecretsDir>$(IntermediateOutputPath)</_ApiSecretsDir>
      <_ApiSecretsFile>$(_ApiSecretsDir)ApiSecrets.g.cs</_ApiSecretsFile>
    </PropertyGroup>
    <MakeDir Directories="$(_ApiSecretsDir)" Condition="!Exists('$(_ApiSecretsDir)')" />
    <WriteLinesToFile File="$(_ApiSecretsFile)" Overwrite="true"
      Lines="// &lt;auto-generated&gt; 由 csproj 的 GenerateApiSecrets 目标生成，不要手改%3B 真实值见本地 build.local.props&#xA;namespace netHEmusic.Core { internal static class ApiSecrets { public const string Base = &quot;$(NetHEApiBase)&quot;%3B } }" />
    <ItemGroup>
      <Compile Include="$(_ApiSecretsFile)" Condition="'$(NetHEApiSecretsAdded)' != 'true'" />
      <FileWrites Include="$(_ApiSecretsFile)" />
    </ItemGroup>
    <PropertyGroup>
      <NetHEApiSecretsAdded>true</NetHEApiSecretsAdded>
    </PropertyGroup>
  </Target>

</Project>
