<Window
    x:Class="netHEmusic.Windows.CertificateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel MaxWidth="560" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE946;" FontSize="28" Foreground="{ThemeResource AppAccentBrush}"/>
                <TextBlock Text="需要安装启动证书" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource AppTextBrush}"/>
            </StackPanel>
            <TextBlock Text="检测到当前计算机尚未安装 netHEmusic 的启动签名证书。为保障软件正常运行，需要先安装证书并信任。是否立即安装？" TextWrapping="Wrap" FontSize="14" LineHeight="24" Foreground="{ThemeResource AppTextBrush}" TextAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="{ThemeResource AppMutedBrush}" TextAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button x:Name="InstallBtn" Click="OnInstall" Content="安装证书" Style="{StaticResource AccentButtonStyle}" Width="140" Height="38"/>
                <Button x:Name="ExitBtn" Click="OnExit" Content="退出" Width="140" Height="38"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
