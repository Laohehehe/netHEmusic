<Window
    x:Class="netHEmusic.Windows.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <StackPanel MaxWidth="620" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <FontIcon Glyph="&#xE896;" FontSize="26" Foreground="{ThemeResource AppAccentBrush}"/>
                <TextBlock Text="发现新版本" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource AppTextBrush}"/>
            </StackPanel>
            <TextBlock x:Name="VerText" FontSize="15" Foreground="{ThemeResource AppMutedBrush}" HorizontalAlignment="Center"/>
            <ScrollViewer MaxHeight="300" Padding="4" VerticalScrollBarVisibility="Auto">
                <!-- 更新日志按 Markdown 逐行渲染成 TextBlock（标题大小分级 / 列表加点 / 去掉 ** 等符号） -->
                <StackPanel x:Name="BodyPanel" Spacing="2"/>
            </ScrollViewer>
            <TextBlock x:Name="StatusText" FontSize="13" Foreground="{ThemeResource AppAccentBrush}" HorizontalAlignment="Center"/>
            <ProgressBar x:Name="UpdateProgress" Height="8" Minimum="0" Maximum="100" Value="0" CornerRadius="4"/>
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                <Button x:Name="UpdateBtn" Click="OnUpdate" Content="立即更新" Style="{StaticResource AccentButtonStyle}" Width="150" Height="40"/>
                <Button x:Name="ExitBtn" Click="OnExit" Content="退出" Width="150" Height="40"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
