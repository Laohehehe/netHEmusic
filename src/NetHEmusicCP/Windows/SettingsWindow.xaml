<Window
    x:Class="netHEmusic.Windows.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <ScrollViewer Padding="24,20">
            <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Center">
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock x:Name="VerLabel" Foreground="{ThemeResource AppMutedBrush}"/>

                <Expander Header="主题 / 外观">
                    <StackPanel Spacing="10">
                        <ComboBox x:Name="SchemeBox" Header="Material You 配色方案" SelectionChanged="OnScheme" Width="320"/>
                        <ToggleSwitch x:Name="MicaToggle" Header="Mica 背景" OffContent="关" OnContent="开" Toggled="OnMica"/>
                        <ToggleSwitch x:Name="CloseTrayToggle" Header="关闭按钮最小化到托盘" OffContent="直接关闭" OnContent="托盘" Toggled="OnCloseTray"/>
                    </StackPanel>
                </Expander>
                <Expander Header="下载">
                    <StackPanel Spacing="10">
                        <TextBox x:Name="DlDirInput" PlaceholderText="下载目录" Width="420"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="BrowseDirBtn" Click="OnBrowseDir" Content="选择目录"/>
                            <Button x:Name="SaveDirBtn" Click="OnSaveDir" Content="保存目录"/>
                        </StackPanel>
                        <ComboBox x:Name="QualityBox" Header="音质" SelectionChanged="OnQuality" Width="260">
                            <ComboBoxItem Content="标准 (128k)"/><ComboBoxItem Content="高品 (320k)"/><ComboBoxItem Content="无损 (Hi-Res)"/>
                        </ComboBox>
                    </StackPanel>
                </Expander>
                <Expander Header="网络 / 代理">
                    <StackPanel Spacing="10">
                        <TextBox x:Name="ProxyInput" PlaceholderText="代理地址，如 127.0.0.1:7890" Width="420"/>
                        <Button x:Name="SaveProxyBtn" Click="OnSaveProxy" Content="保存代理"/>
                    </StackPanel>
                </Expander>
                <Expander Header="语言 / 日志">
                    <StackPanel Spacing="10">
                        <ComboBox x:Name="LangBox" Header="界面语言" SelectionChanged="OnLang" Width="240">
                            <ComboBoxItem Content="简体中文"/><ComboBoxItem Content="English"/>
                        </ComboBox>
                        <Button x:Name="OpenLogBtn" Click="OnOpenLog" Content="打开日志目录"/>
                        <Button x:Name="ClearLogBtn" Click="OnClearLog" Content="清空当前日志"/>
                    </StackPanel>
                </Expander>
                <Expander Header="桌面歌词">
                    <StackPanel Spacing="10">
                        <ToggleSwitch x:Name="DeskLyricToggle" Header="启用桌面歌词" OffContent="关" OnContent="开" Toggled="OnDeskLyric"/>
                        <ToggleSwitch x:Name="DeskLyricTopToggle" Header="强制置顶 + 鼠标穿透" OffContent="关" OnContent="开" Toggled="OnDeskLyricTop"/>
                        <ToggleSwitch x:Name="DeskSongInfoToggle" Header="桌面歌曲信息" OffContent="关" OnContent="开" Toggled="OnDeskSongInfo"/>
                    </StackPanel>
                </Expander>
                <Expander Header="播放">
                    <StackPanel Spacing="10">
                        <Slider x:Name="VolumeSlider" Header="默认音量" Minimum="0" Maximum="100" ValueChanged="OnVolume"/>
                        <ComboBox x:Name="PlayModeBox" Header="播放模式" SelectionChanged="OnPlayMode" Width="220">
                            <ComboBoxItem Content="顺序播放"/><ComboBoxItem Content="列表循环"/><ComboBoxItem Content="单曲循环"/><ComboBoxItem Content="随机播放"/>
                        </ComboBox>
                    </StackPanel>
                </Expander>
                <Expander Header="通知">
                    <StackPanel Spacing="10">
                        <ToggleSwitch x:Name="ToastToggle" Header="下载完成通知" OffContent="关" OnContent="开" Toggled="OnToast"/>
                    </StackPanel>
                </Expander>
                <Expander Header="关于">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="AboutVer" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock x:Name="AboutDesc" TextWrapping="Wrap" Foreground="{ThemeResource AppMutedBrush}" FontSize="12"/>
                    </StackPanel>
                </Expander>
                <Button x:Name="DoneBtn" Click="OnDone" Content="完成" Width="140" HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
