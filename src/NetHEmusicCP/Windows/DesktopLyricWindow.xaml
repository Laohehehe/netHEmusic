<Window
    x:Class="netHEmusic.Windows.DesktopLyricWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 桌面歌词：整窗透明，桌面上只看得见歌词文字本身 -->
    <Grid x:Name="Root" Background="Transparent">
        <!-- 「取消锁定」后鼠标移到歌词上才露出的提示框：只有一圈细边框，没有底色，
             平时完全不显示，保证桌面上始终只有歌词 -->
        <Border x:Name="EditFrame" CornerRadius="10" BorderThickness="1"
                BorderBrush="#55888888" Background="Transparent" Visibility="Collapsed"/>
        <StackPanel x:Name="Lyric" Orientation="Vertical" Spacing="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,6">
            <Grid x:Name="MainHost" HorizontalAlignment="Center"/>
            <Grid x:Name="SubHost" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
