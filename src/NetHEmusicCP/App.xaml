<Application
    x:Class="netHEmusic.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:netHEmusic">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI3 默认控件资源（必需，否则 TabViewButtonBackground 等缺失） -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/FluentStyles.xaml"/>
                <ResourceDictionary Source="ms-appx:///Themes/Theme.xaml"/>
                <ResourceDictionary Source="ms-appx:///Themes/AppStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
