<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <!-- 亮色 -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7FA"/>
            <SolidColorBrush x:Key="AppSurfaceDarkenBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AppTextBrush" Color="#123354"/>
            <SolidColorBrush x:Key="AppBackgroundAltBrush" Color="#EAEFF4"/>
            <SolidColorBrush x:Key="AppBorderBrush" Color="#D0D7DE"/>
            <SolidColorBrush x:Key="AppMutedBrush" Color="#61717C"/>
        </ResourceDictionary>
        <!-- 暗色 -->
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E2529"/>
            <SolidColorBrush x:Key="AppSurfaceDarkenBrush" Color="#171D20"/>
            <SolidColorBrush x:Key="AppTextBrush" Color="#BDE6FB"/>
            <SolidColorBrush x:Key="AppBackgroundAltBrush" Color="#24303B"/>
            <SolidColorBrush x:Key="AppBorderBrush" Color="#2E3B46"/>
            <SolidColorBrush x:Key="AppMutedBrush" Color="#8A98A5"/>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- 默认强调色（主题管理器运行时会覆盖为当前 scheme 的 accent） -->
    <SolidColorBrush x:Key="AppAccentBrush" Color="#BDE6FB"/>
</ResourceDictionary>
