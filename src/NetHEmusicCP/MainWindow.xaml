<Window
    x:Class="netHEmusic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="{ThemeResource AppBackgroundBrush}">
        <!-- 无原生标题栏（标题栏高度按用户要求为 0）：窗口内容整块交给 WebView2，
             系统的最小化/最大化/关闭由系统自己浮在网页右上角（ExtendsContentIntoTitleBar）。
             注意：不要在这里加回任何标题栏行高；网页也不自绘拖拽带（顶部那片就是 WinUI 原生拖拽区）。 -->
        <WebView2 x:Name="WebView"/>

        <!-- 启动兜底面板：WebView2 初始化失败时显示。
             页面是唯一的绘制者，WebView2 起不来时窗口就是一片透明 —— 以前用户只能看到"半透明/什么都没有"，
             现在至少给出错误原因、重试、装运行时、打开日志四个出口。 -->
        <Grid x:Name="StartupErrorPanel" Visibility="Collapsed" Background="#FF101014">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="760" Spacing="12" Padding="36">
                <FontIcon Glyph="&#xE7BA;" FontSize="40" HorizontalAlignment="Center" Foreground="#FFE05A5A"/>
                <TextBlock x:Name="StartupErrorTitle" Text="界面加载失败" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="#FFF2F2F2"/>
                <TextBlock x:Name="StartupErrorDetail" TextWrapping="Wrap" TextAlignment="Center"
                           FontSize="13" LineHeight="20" Foreground="#FFC9C9D1"/>
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <Button x:Name="StartupErrorRetryBtn" Content="重试" Click="OnStartupErrorRetry"/>
                    <Button x:Name="StartupErrorFixBtn" Content="下载 WebView2 运行时" Click="OnStartupErrorFix"/>
                    <Button x:Name="StartupErrorLogBtn" Content="打开日志文件夹" Click="OnStartupErrorOpenLog"/>
                </StackPanel>
                <TextBlock x:Name="StartupErrorHint" TextWrapping="Wrap" TextAlignment="Center"
                           FontSize="12" Opacity="0.65" Foreground="#FFC9C9D1"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
